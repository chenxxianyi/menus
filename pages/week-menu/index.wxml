<view class="page-week">
  <navbar title="一周菜单" />

  <view class="week-calendar">
    <view class="day-card {{activeDay === index ? 'active' : ''}}" wx:for="{{days}}" wx:key="key" bindtap="setDay" data-idx="{{index}}">
      <view class="day-label">{{item.label}}</view>
      <view class="day-date">{{item.date}}</view>
    </view>
  </view>

  <view class="day-meals">
    <view class="meal-section" wx:for="{{['早餐','午餐','晚餐']}}" wx:key="*this">
      <view class="meal-header">
        <text class="meal-title">{{item}}</text>
        <view class="regen-btn" bindtap="regenerate" data-meal="{{item}}">换一换</view>
      </view>
      <view class="meal-dishes">
        <view class="mini-dish glass-card" wx:for="{{currentMeals[item]}}" wx:key="id">
          <view class="mini-dish-name">{{item.name}}</view>
          <view class="mini-dish-meta">{{item.time}}分钟</view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn-primary bottom-action" bindtap="addAllToShopping">一键加入购物清单</view>
</view>
