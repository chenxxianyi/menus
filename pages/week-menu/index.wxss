.page-week { padding: 20rpx 30rpx; }

.week-calendar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
}

.day-card {
  flex-shrink: 0;
  width: calc(14.28% - 8rpx);
  min-width: 80rpx;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: var(--r-md);
  background: var(--glass-strong);
  border: 1px solid var(--glass-border);
}

.day-card.active {
  background: var(--mint-bg);
  border-color: var(--mint);
}

.day-label { font-size: 22rpx; color: var(--text-secondary); font-weight: 600; }
.day-card.active .day-label { color: var(--primary-deep); }
.day-date { font-size: 20rpx; color: var(--text-placeholder); margin-top: 4rpx; }

.meal-section { margin-bottom: 24rpx; }
.meal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.meal-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.regen-btn { font-size: 22rpx; color: var(--primary-deep); font-weight: 600; }

.mini-dish {
  display: inline-block;
  padding: 12rpx 20rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.mini-dish-name { font-size: 26rpx; font-weight: 600; color: var(--text); }
.mini-dish-meta { font-size: 20rpx; color: var(--text-secondary); margin-top: 2rpx; }

.bottom-action {
  margin-top: 20rpx;
  text-align: center;
  padding: 24rpx;
}
