.page-home {
  min-height: 100vh;
  background: linear-gradient(160deg, #F8F0FF 0%, #FFF5F5 30%, #F0FFF5 60%, #F5F0FF 100%);
}

.home-header {
  padding: 60rpx 30rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255,255,255,.2);
  backdrop-filter: blur(24px) saturate(180%);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx;
  background: var(--glass-strong);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-pill);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.5);
}

.search-icon {
  font-size: 28rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

.home-scroll {
  padding: 0 30rpx;
  height: calc(100vh - 140rpx);
}

.banner-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, rgba(168,216,185,.3), rgba(197,179,230,.25));
}

.banner-tag {
  font-size: 22rpx;
  color: var(--primary-deep);
  background: var(--mint-bg);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  display: inline-block;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text);
}

.banner-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.banner-action {
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  white-space: nowrap;
}

.meal-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.meal-card {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
}

.meal-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.meal-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.meal-count {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.category-item {
  width: calc(25% - 15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 1px solid var(--glass-border);
}

.category-name {
  font-size: 22rpx;
  color: var(--text);
  font-weight: 600;
}

.ai-card {
  background: linear-gradient(135deg, rgba(197,179,230,.25), rgba(255,181,194,.2));
  text-align: center;
  padding: 40rpx;
}

.ai-badge {
  font-size: 22rpx;
  color: var(--lilac);
  background: var(--lavender-bg);
  padding: 4rpx 20rpx;
  border-radius: var(--r-pill);
  display: inline-block;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.ai-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 8rpx;
}

.ai-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.ai-action {
  font-size: 26rpx;
  color: var(--primary-deep);
  font-weight: 700;
}
