<view class="page-home">
  <!-- 顶部搜索框 -->
  <view class="home-header">
    <view class="search-bar" bindtap="goSearch">
      <text class="search-icon">&#128269;</text>
      <text class="search-placeholder">搜索菜谱、食材...</text>
    </view>
  </view>

  <scroll-view scroll-y class="home-scroll">
    <!-- 今日推荐 Banner -->
    <view class="banner-card glass-card">
      <view class="banner-content">
        <view class="banner-tag">今日推荐</view>
        <view class="banner-title">夏日清爽菜单</view>
        <view class="banner-desc">3 道菜品，营养均衡</view>
      </view>
      <view class="banner-action btn-primary" bindtap="goRecommend">立即查看</view>
    </view>

    <!-- 三餐推荐 -->
    <view class="section-title">今日三餐</view>
    <view class="meal-row">
      <view class="meal-card glass-card" wx:for="{{meals}}" wx:key="key" bindtap="goMealRecommend" data-meal="{{item.key}}">
        <view class="meal-emoji">{{item.emoji}}</view>
        <view class="meal-name">{{item.name}}</view>
        <view class="meal-count">{{item.count}} 道推荐</view>
      </view>
    </view>

    <!-- 分类入口 -->
    <view class="section-title">热门分类</view>
    <view class="category-grid">
      <view class="category-item" wx:for="{{categories}}" wx:key="key" bindtap="goCategory" data-key="{{item.key}}">
        <view class="category-icon" style="background: {{item.bg}}">{{item.emoji}}</view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>

    <!-- 热门菜谱 -->
    <view class="section-title">热门菜谱</view>
    <recipe-card
      wx:for="{{hotRecipes}}"
      wx:key="id"
      recipe="{{item}}"
      bind:tap="goDetail"
      bind:favorite="toggleFavorite"
    />

    <!-- AI 推荐入口 -->
    <view class="ai-card glass-card" bindtap="goRecommend">
      <view class="ai-badge">AI 推荐</view>
      <view class="ai-title">不知道吃什么？</view>
      <view class="ai-desc">告诉我你的偏好，为你智能推荐</view>
      <view class="ai-action">开始推荐 →</view>
    </view>

    <view style="height: 30rpx"></view>
  </scroll-view>
</view>
