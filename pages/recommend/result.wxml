<view class="page-result">
  <navbar title="推荐结果" />

  <view class="result-header glass-card">
    <view class="result-name">营养均衡午餐</view>
    <view class="result-reason">根据您的口味偏好和饮食目标，为您推荐以下菜品组合</view>
  </view>

  <view class="section-title">推荐菜品</view>
  <view class="dish-card glass-card" wx:for="{{dishes}}" wx:key="id">
    <view class="dish-cover" style="background: {{item.bg}}"></view>
    <view class="dish-info">
      <view class="dish-name">{{item.name}}</view>
      <view class="dish-meta">{{item.time}}分钟 · {{item.cal}}kcal</view>
    </view>
  </view>

  <view class="section-title">总食材清单</view>
  <view class="glass-card">
    <view class="ing-item" wx:for="{{ingredients}}" wx:key="*this">
      <text>{{item}}</text>
    </view>
  </view>

  <view class="result-actions">
    <view class="btn-primary" bindtap="addToShopping">一键加入购物清单</view>
    <view class="btn-secondary" bindtap="saveMenu">保存菜单</view>
  </view>
</view>
