.page-recommend { padding: 20rpx 30rpx; }

.tag-group { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }

.number-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.num-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  background: var(--glass-strong);
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text);
  font-weight: 700;
}

.num-val {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text);
  min-width: 60rpx;
  text-align: center;
}

.num-unit { font-size: 26rpx; color: var(--text-secondary); }

.tag-input-area { margin-bottom: 20rpx; }

.tag-list { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 12rpx; }

.tag-close {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.tag-input {
  font-size: 28rpx;
  padding: 8rpx 0;
  border-top: 1px solid rgba(255,255,255,.2);
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.3);
  backdrop-filter: blur(24px);
  border-top: 1px solid var(--glass-border);
  z-index: 50;
}

.bottom-btn text {
  display: block;
  text-align: center;
  background: linear-gradient(135deg, var(--mint), var(--primary-deep));
  color: #fff;
  border-radius: var(--r-md);
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}
