.page-fav { padding: 20rpx 30rpx; }

.tab-row {
  display: flex;
  gap: 0;
  margin-bottom: 24rpx;
  background: var(--glass-strong);
  border-radius: var(--r-pill);
  border: 1px solid var(--glass-border);
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
  transition: all .15s;
}

.tab.active {
  background: var(--mint-bg);
  color: var(--primary-deep);
}

.menu-name { font-size: 30rpx; font-weight: 700; color: var(--text); }
.menu-meta { font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; }
