<view class="page-shopping">
  <navbar title="购物清单" />

  <view class="category-section" wx:for="{{groups}}" wx:key="category">
    <view class="cat-title">{{item.category}}</view>
    <view class="glass-card">
      <view class="shop-item" wx:for="{{item.items}}" wx:key="name">
        <view class="shop-check {{item.checked ? 'checked' : ''}}" bindtap="toggleCheck" data-cat="{{item2.category}}" data-name="{{item.name}}">
          <text wx:if="{{item.checked}}">&#10003;</text>
        </view>
        <text class="shop-name {{item.checked ? 'done' : ''}}">{{item.name}}</text>
        <text class="shop-amount">{{item.amount}}</text>
        <text class="shop-del" catchtap="removeItem" data-cat="{{item2.category}}" data-name="{{item.name}}">×</text>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!groups.length}}" text="购物清单为空" actionText="去推荐菜品" bind:action="goRecommend" />

  <view class="add-row">
    <input class="add-input" placeholder="手动添加食材" bindconfirm="addItem" />
  </view>

  <view class="clear-btn" wx:if="{{groups.length}}" bindtap="clearAll">清空购物清单</view>
</view>
