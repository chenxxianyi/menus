.page-pref { padding: 20rpx 30rpx; }
.tag-group { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.number-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.num-btn {
  width: 64rpx; height: 64rpx; border-radius: var(--r-md);
  background: var(--glass-strong); border: 1px solid var(--glass-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: var(--text); font-weight: 700;
}
.num-val { font-size: 36rpx; font-weight: 800; color: var(--text); min-width: 60rpx; text-align: center; }
.num-unit { font-size: 26rpx; color: var(--text-secondary); }
.save-btn { margin-top: 40rpx; text-align: center; }
