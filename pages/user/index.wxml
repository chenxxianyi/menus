<view class="page-user">
  <view class="user-header">
    <view class="avatar">{{userInfo.name || '登'}}</view>
    <view class="user-info">
      <view class="user-name">{{userInfo.name || '点击登录'}}</view>
      <view class="user-desc">{{userInfo.phone || '登录后享受更多功能'}}</view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item glass-card" bindtap="goPage" data-url="/pages/favorite/index">
      <text class="menu-label">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item glass-card" bindtap="goPage" data-url="/pages/week-menu/index">
      <text class="menu-label">我的菜单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item glass-card" bindtap="goPage" data-url="/pages/shopping/index">
      <text class="menu-label">购物清单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item glass-card" bindtap="goPage" data-url="/pages/user/preferences">
      <text class="menu-label">饮食偏好</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item glass-card" bindtap="goPage" data-url="/pages/feedback/index">
      <text class="menu-label">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="login-btn btn-primary" wx:if="{{!isLoggedIn}}" bindtap="doLogin">微信登录</view>
</view>
