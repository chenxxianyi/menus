.page-user { padding: 20rpx 30rpx; }

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--mint), var(--lavender));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
  border: 2px solid rgba(255,255,255,.5);
}

.user-name { font-size: 34rpx; font-weight: 800; color: var(--text); }
.user-desc { font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; }

.menu-list { margin-top: 10rpx; }

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.menu-label { font-size: 28rpx; font-weight: 600; color: var(--text); }
.menu-arrow { font-size: 32rpx; color: var(--text-placeholder); }

.login-btn {
  margin-top: 40rpx;
  text-align: center;
}
