.page-detail { min-height: 100vh; padding-bottom: 120rpx; }

.detail-cover {
  width: 100%;
  height: 400rpx;
  background: var(--lavender-bg);
}

.detail-body { padding: 20rpx 30rpx; }

.detail-header { text-align: center; }

.detail-name {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 12rpx;
}

.detail-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.detail-meta {
  display: flex;
  justify-content: center;
  gap: 30rpx;
}

.meta-badge {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--glass-bg);
  padding: 6rpx 20rpx;
  border-radius: var(--r-pill);
}

.meta-val {
  font-weight: 700;
  color: var(--primary-deep);
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(255,255,255,.2);
}

.ingredient-item:last-child { border-bottom: none; }

.ing-name { font-weight: 600; color: var(--text); }
.ing-amount { color: var(--text-secondary); font-size: 24rpx; }

.step-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(255,255,255,.15);
}

.step-item:last-child { border-bottom: none; }

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--mint-bg);
  color: var(--primary-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text);
}

.tips-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(255,255,255,.35);
  backdrop-filter: blur(24px) saturate(180%);
  border-top: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
}

.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bar-icon {
  font-size: 40rpx;
  color: var(--text-secondary);
}

.bar-icon.active { color: var(--accent); }

.bar-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}
