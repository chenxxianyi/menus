<view class="page-detail">
  <navbar title="菜谱详情" />

  <image class="detail-cover" src="{{recipe.cover || '/assets/images/placeholder.png'}}" mode="aspectFill" />

  <view class="detail-body">
    <view class="detail-header glass-card">
      <view class="detail-name">{{recipe.name}}</view>
      <view class="detail-desc">{{recipe.description}}</view>
      <view class="detail-meta">
        <view class="meta-badge"><text class="meta-val">{{recipe.time}}</text>分钟</view>
        <view class="meta-badge"><text class="meta-val">{{recipe.difficulty}}</text></view>
        <view class="meta-badge"><text class="meta-val">{{recipe.servings}}</text>人份</view>
      </view>
    </view>

    <view class="section-title">所需食材</view>
    <view class="glass-card">
      <view class="ingredient-item" wx:for="{{recipe.ingredients}}" wx:key="name">
        <text class="ing-name">{{item.name}}</text>
        <text class="ing-amount">{{item.amount}}</text>
      </view>
    </view>

    <view class="section-title">调料</view>
    <view class="glass-card">
      <view class="ingredient-item" wx:for="{{recipe.seasonings}}" wx:key="name">
        <text class="ing-name">{{item.name}}</text>
        <text class="ing-amount">{{item.amount}}</text>
      </view>
    </view>

    <view class="section-title">制作步骤</view>
    <view class="glass-card">
      <view class="step-item" wx:for="{{recipe.steps}}" wx:key="index">
        <view class="step-num">{{index + 1}}</view>
        <view class="step-text">{{item}}</view>
      </view>
    </view>

    <view class="section-title" wx:if="{{recipe.tips}}">小技巧</view>
    <view class="glass-card" wx:if="{{recipe.tips}}">
      <text class="tips-text">{{recipe.tips}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-btn" bindtap="toggleFavorite">
      <text class="bar-icon {{recipe.isFavorite ? 'active' : ''}}">&#9829;</text>
      <text class="bar-label">{{recipe.isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="bar-btn" bindtap="addToShopping">
      <text class="bar-icon">&#128722;</text>
      <text class="bar-label">购物清单</text>
    </view>
    <view class="bar-btn" bindtap="shareRecipe">
      <text class="bar-icon">&#8599;</text>
      <text class="bar-label">分享</text>
    </view>
  </view>
</view>
