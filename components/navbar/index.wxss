.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255,255,255,.25);
  backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1px solid var(--glass-border);
}

.navbar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  position: relative;
}

.navbar-back {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 24px;
  color: var(--text);
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
}

.navbar-right {
  min-width: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.navbar-placeholder {
  width: 100%;
}
