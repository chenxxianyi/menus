.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: var(--text-placeholder);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.empty-action {
  font-size: 28rpx;
  color: var(--primary-deep);
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: var(--r-pill);
  background: var(--mint-bg);
  border: 1px solid var(--mint);
}
