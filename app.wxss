/* ===== Macaron + Liquid Glass Design System ===== */
page {
  --rose: #FFB5C2;
  --rose-soft: #FFCDD9;
  --rose-bg: rgba(255,181,194,.12);
  --lavender: #C5B3E6;
  --lavender-soft: #DDD2F0;
  --lavender-bg: rgba(197,179,230,.12);
  --mint: #A8D8B9;
  --mint-soft: #C5E8D0;
  --mint-bg: rgba(168,216,185,.12);
  --sky: #A8C8E8;
  --sky-soft: #C5D9F0;
  --sky-bg: rgba(168,200,232,.12);
  --peach: #FFD1BA;
  --peach-soft: #FFE0CC;
  --peach-bg: rgba(255,209,186,.12);
  --lemon: #FFF0B3;
  --lemon-soft: #FFF7CC;
  --lemon-bg: rgba(255,240,179,.12);
  --lilac: #D5A8E0;
  --lilac-soft: #E4C5EC;
  --cream: #FFF8F0;

  --primary: #A8D8B9;
  --primary-deep: #6BAF82;
  --accent: #FFB5C2;
  --accent-deep: #F0899E;

  --text: #4A4258;
  --text-secondary: #8E82A0;
  --text-placeholder: #BDB0CC;

  --glass-bg: rgba(255,255,255,.22);
  --glass-strong: rgba(255,255,255,.38);
  --glass-border: rgba(255,255,255,.5);
  --glass-blur: 24px;

  --r-sm: 10px;
  --r-md: 14px;
  --r-lg: 20px;
  --r-xl: 24px;
  --r-pill: 9999px;

  font-family: -apple-system, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text);
  background: linear-gradient(160deg, #F8F0FF 0%, #FFF5F5 30%, #F0FFF5 60%, #F5F0FF 100%);
  min-height: 100vh;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== Glass Card ===== */
.glass-card {
  background: var(--glass-strong);
  backdrop-filter: blur(var(--glass-blur)) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg);
  box-shadow: 0 8rpx 32rpx rgba(100,80,130,.06), inset 0 1px 0 rgba(255,255,255,.65);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* ===== Status Tag ===== */
.status-tag {
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.success {
  background: var(--mint-bg);
  color: var(--primary-deep);
}

.status-tag.warning {
  background: rgba(240,200,122,.12);
  color: #B08830;
}

/* ===== Section Title ===== */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

/* ===== Tag ===== */
.tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  background: var(--glass-strong);
  border: 1px solid var(--glass-border);
  color: var(--text-secondary);
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}

.tag.active {
  background: var(--mint-bg);
  color: var(--primary-deep);
  border-color: var(--mint);
  font-weight: 600;
}

/* ===== Button ===== */
.btn-primary {
  background: linear-gradient(135deg, var(--mint), var(--primary-deep));
  color: #fff;
  border: none;
  border-radius: var(--r-md);
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.btn-primary:active {
  opacity: .85;
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: var(--text-placeholder);
  font-size: 28rpx;
}
