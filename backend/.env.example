# Application
APP_ENV=development
APP_DEBUG=true
JWT_SECRET_KEY=replace-with-a-long-random-secret-for-production

# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=menu_recommend
DATABASE_USER=root
DATABASE_PASSWORD=replace-with-local-database-password
DB_AUTO_MIGRATE=true

# Redis
REDIS_PASSWORD=

# AI (leave empty to disable AI features locally)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECS=60

# Safety controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_PER_WINDOW=5
AI_MAX_CONCURRENT=4
MYSQL_ROOT_PASSWORD=replace-with-a-local-password
